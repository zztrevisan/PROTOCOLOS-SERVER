# Modo interno (server.js)
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=1
NODE_ENV=production
SQLITE_DATABASE_PATH=banco/hiperion.db

# Por padrão, a API aceita somente chamadas feitas pelo próprio sistema.
# Preencha apenas se futuramente existir uma interface em outro domínio.
ALLOWED_ORIGINS=

# Necessárias somente para exportar o banco atual do Turso.
# Nunca envie os valores reais ao GitHub.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Envio de comprovantes após a entrega (Resend).
# Configure os valores reais somente no servidor/Vercel.
RESEND_API_KEY=
EMAIL_FROM=Hiperion Protocolos <protocolos@seudominio.com.br>
